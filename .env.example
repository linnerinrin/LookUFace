# ============================================================
# LookUFace 配置模板
# 用法：复制为 .env 后按需修改。.env 已被 .gitignore 忽略，切勿提交真实凭据。
# ============================================================

# ---------- 应用 ----------
APP_NAME=CV Face Analysis Service
APP_VERSION=1.0.0
DEBUG=False
HOST=0.0.0.0
PORT=8000
# CORS 允许来源，逗号分隔；生产环境务必写成具体域名，不要用 *
ALLOWED_ORIGINS=*

# ---------- 数据库 ----------
# 相对路径以项目根目录为基准（不再依赖启动时的工作目录）
DATABASE_URL=sqlite:///./storage/face_lens.db

# ---------- 认证 ----------
# 必填。生成方式：python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ---------- 邮件（SMTP） ----------
SMTP_HOST=smtp.qq.com
SMTP_PORT=587
SMTP_USER=your_account@qq.com
# 邮箱授权码，不是登录密码
SMTP_PASSWORD=

# ---------- 视觉模型阈值 ----------
# 人脸检测置信度：OpenCV DNN 推荐 0.5，0.9+ 会大量漏检
FACE_CONF_THRESHOLD=0.5
# 人脸识别余弦相似度阈值：需用真实样本标定，默认 0.75
RECOGNIZE_THRESHOLD=0.75
# 关键点检测/跟踪置信度
DETECTION_CONFIDENCE=0.5
TRACKING_CONFIDENCE=0.5

# ---------- 业务参数 ----------
# 签到去抖：同一张脸在此时长（秒）内的识别结果只触发一次签到
CHECKIN_DEBOUNCE_SECONDS=5
# 暂离超时（分钟）：超过则自动签退结算
AWAY_TIMEOUT_MINUTES=30
# 计费单价（元/分钟）
BILLING_RATE_PER_MINUTE=0.5
# 单次会话最长计费时长（分钟），防止异常数据产生天价账单
MAX_SESSION_MINUTES=1440
