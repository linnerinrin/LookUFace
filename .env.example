# ============================================================
# LookUFace 配置模板
# 用法：复制为 .env 后按需修改。.env 已被 .gitignore 忽略，切勿提交真实凭据。
# ============================================================

# ---------- 应用 ----------
APP_NAME=LookUFace
APP_VERSION=1.2.0
DEBUG=False
# 系统没有任何身份校验，默认只监听本机
HOST=127.0.0.1
PORT=8835
# CORS 允许来源，逗号分隔；生产环境务必写成具体域名，不要用 *
# 注意：改 PORT 时这里也要一起改，否则浏览器会按跨源拒绝（表现为 Failed to fetch）
ALLOWED_ORIGINS=http://127.0.0.1:8835,http://localhost:8835

# ---------- 数据库 ----------
# 相对路径以项目根目录为基准（不依赖启动时的工作目录）
DATABASE_URL=sqlite:///./storage/face_lens.db

# ---------- 视觉模型阈值 ----------
# 人脸检测置信度：OpenCV DNN 推荐 0.5，0.9+ 会大量漏检
FACE_CONF_THRESHOLD=0.5
# 身份识别相似度阈值：需用真实样本标定，默认 0.75
RECOGNIZE_THRESHOLD=0.75
# 人脸检测/关键点置信度
DETECTION_CONFIDENCE=0.5
TRACKING_CONFIDENCE=0.5

# ---------- 并发 ----------
MAX_PENDING_FRAMES=1
