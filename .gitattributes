# 行尾规范
#
# .bat / .cmd 必须是 CRLF：cmd.exe 的批处理解析器在 LF-only 文件上会
# 逐字节拆错 REM 注释与命令，导致脚本瞬间退出（窗口一闪而过）。
# 这里让 Git 在检出时始终写回 CRLF，避免编辑器或工具把它改成 LF。
*.bat   text eol=crlf
*.cmd   text eol=crlf

# 其余文本统一为 LF
*.py    text eol=lf
*.js    text eol=lf
*.mjs   text eol=lf
*.html  text eol=lf
*.css   text eol=lf
*.md    text eol=lf
*.toml  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.json  text eol=lf
*.txt   text eol=lf
.gitignore      text eol=lf
.gitattributes  text eol=lf
.dockerignore   text eol=lf
Dockerfile      text eol=lf

# 二进制：不做任何行尾转换
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.pb    binary
*.pbtxt binary
*.caffemodel binary
*.prototxt   binary
*.db    binary
*.ico   binary
*.woff  binary
*.woff2 binary
